<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <VideoView
        android:id="@+id/simpleVideoView"
        android:layout_width="376dp"
        android:layout_height="340dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.552"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.018"
        />

    <ImageView
        android:id="@+id/verified_by_vreal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"

        android:src="@mipmap/verified_by_vreal_foreground"
        app:layout_constraintTop_toBottomOf="@id/simpleVideoView"
        app:layout_constraintLeft_toLeftOf="parent"

        />

    <TextView
        android:id="@+id/algo_details"
        android:layout_width="270dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        android:fontFamily="@font/montserrat_semibold"
        android:text="Cryptographically verified using Edwards-curve Digital Signature Algorithm (256 bit key pair)"
        app:layout_constraintLeft_toRightOf="@id/verified_by_vreal"
        app:layout_constraintTop_toBottomOf="@id/simpleVideoView" />

    <TextView
                android:id="@+id/capture_device"
                android:layout_width="200dp"
                android:layout_height="116dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="@font/montserrat_regular"
                android:text="This video was captured on October 3rd 2024,by a device identified as Rpi 4 Model B (8ae70ad544babdb3b1)
at 27° 33' 3.924'' S | 153° 2' 12.1092'' E"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@id/algo_details" />


    <ImageView
        android:id="@+id/capture_location"
        android:layout_width="163dp"
        android:layout_height="145dp"
        android:src="@mipmap/location_place_holder"
        app:layout_constraintLeft_toRightOf="@id/capture_device"
        app:layout_constraintTop_toBottomOf="@id/algo_details" />

</androidx.constraintlayout.widget.ConstraintLayout>
