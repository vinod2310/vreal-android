<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@drawable/gradient">


    <ImageView
        android:id="@+id/main_logo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:contentDescription="TODO"
        android:orientation="vertical"
        android:src="@drawable/vreal_logo_black_on_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.508"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.21" />

    <Button
        android:id="@id/gap1"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_margin="0dp"


        android:contentDescription="TODO"
        android:background="@color/zxing_transparent"


        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/main_logo" />

    <TextView
        android:id="@id/textResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_semibold"
        android:layout_margin="0dp"

        android:text="@string/main_screen_welcome_message"
        android:textAlignment="center"
        android:textSize="25sp"
        android:textStyle="normal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gap1"


        />
    <Button
        android:id="@id/gap2"
        android:layout_width="match_parent"
        android:layout_height="200dp"

        android:contentDescription="TODO"
        android:background="@color/zxing_transparent"

        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textResult" />


    <ImageButton
        android:id="@id/button_capture_video"
        android:layout_width="300dp"
        android:layout_height="61dp"


        android:contentDescription="TODO"
        app:circularflow_radiusInDP="20dp"

        android:src="@drawable/capture_media"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gap3" />

    <Button
        android:id="@id/gap3"
        android:layout_width="match_parent"
        android:layout_height="30dp"

        android:contentDescription="TODO"
        android:background="@color/zxing_transparent"


        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_scan_qr" />
    <ImageButton
        android:id="@id/button_scan_qr"
        android:layout_height="61dp"
        android:layout_width="300dp"
        android:layout_gravity="start"
        android:src="@drawable/scan_qr_v3"
        android:contentDescription="TODO"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gap2"

        />

    <androidx.coordinatorlayout.widget.CoordinatorLayout android:layout_height="30dp"
        android:layout_width="fill_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@id/bottom_bar_container"
        >


            <com.google.android.material.bottomappbar.BottomAppBar
                android:id="@id/bottomAppBar"
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.coordinatorlayout.widget.CoordinatorLayout>


</androidx.constraintlayout.widget.ConstraintLayout>




